<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AdminPortal</RootNamespace>
    <!-- Keeps the Supabase anon key out of appsettings.json / GitHub -->
    <UserSecretsId>campus-coupon-admin-portal</UserSecretsId>
  </PropertyGroup>

  <!-- No extra NuGet packages needed: Supabase is called through its REST API
       with HttpClient + System.Text.Json (both built into .NET 8). -->

</Project>
